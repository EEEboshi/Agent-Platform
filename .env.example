# ============================================
# AI Agent Platform 环境变量配置示例
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 确保 .env 文件不被提交到版本控制（已添加到 .gitignore）
# ============================================

# ============================================
# 大模型配置（阿里云通义千问）
# ============================================
# 阿里云 DashScope API 密钥（必填）
# 获取方式：登录阿里云控制台 -> DashScope -> API Key 管理
DASHSCOPE_API_KEY=your_api_key_here

# 阿里云 DashScope API 基础地址（可选，默认值如下）
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 使用的模型名称（可选，默认：qwen-max）
# 可选值：qwen-max, qwen-plus, qwen-turbo 等
DASHSCOPE_MODEL=qwen-max

# ============================================
# Agent 配置
# ============================================
# Agent 温度参数（可选，默认：0.1）
# 范围：0.0 - 1.0，较低值保证工具调用稳定性
AGENT_TEMPERATURE=0.1

# 记忆 Token 限制（可选，默认：8000）
# 控制对话历史的最大长度
AGENT_MEMORY_TOKEN_LIMIT=8000

# 单次对话最大工具调用次数（可选，默认：10）
# 防止无限循环调用工具
AGENT_MAX_FUNCTION_CALLS=10

# ============================================
# 搜索工具配置
# ============================================
# 搜索最大结果数（可选，默认：5）
SEARCH_MAX_RESULTS=5

# 搜索超时时间（秒）（可选，默认：10）
# 超过此时间将触发重试
SEARCH_TIMEOUT=10

# 最大重试次数（可选，默认：3）
# 网络错误时的自动重试次数
SEARCH_MAX_RETRIES=3

# 重试延迟（秒）（可选，默认：1.0）
# 每次重试前的等待时间（会递增）
SEARCH_RETRY_DELAY=1.0

# 代理配置（可选）
# 如果在国内访问 DuckDuckGo 不稳定，可配置代理
# 格式：http://username:password@proxy_host:proxy_port
# SEARCH_PROXY=http://127.0.0.1:7890

# ============================================
# 服务配置
# ============================================
# API 服务器端口（可选，默认：8000）
API_PORT=8000

# UI 服务器端口（可选，默认：7860）
UI_PORT=7860

# ============================================
# 其他配置
# ============================================
# 日志级别（可选，默认：INFO）
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
